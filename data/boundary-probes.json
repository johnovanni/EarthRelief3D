{
  // Points that must stay in their country whatever edition of the boundaries is in use. A downloaded set that fails
  // any of them is not used (GlobeCore's BoundaryValidator; the Borders status dot turns amber with the reason).
  "probes": [
    { "name": "Khartoum", "lat": 15.5, "lon": 32.53, "expect": "SDN" },
    { "name": "Kyiv", "lat": 50.45, "lon": 30.52, "expect": "UKR" },
    { "name": "Crimea (Simferopol area)", "lat": 45.0, "lon": 34.1, "expect": "UKR" },
    { "name": "Sevastopol", "lat": 44.6, "lon": 33.5, "expect": "UKR" },
    { "name": "Fiji, west of the date line", "lat": -16.93, "lon": 179.95, "expect": "FJI" },
    { "name": "Fiji, east of the date line", "lat": -16.85, "lon": -179.95, "expect": "FJI" },
    { "name": "Hargeisa (Somaliland, counted with Somalia)", "lat": 9.56, "lon": 44.06, "expect": "SOM" },
    { "name": "Gaza", "lat": 31.5, "lon": 34.45, "expect": "PSE" }
  ]
}
