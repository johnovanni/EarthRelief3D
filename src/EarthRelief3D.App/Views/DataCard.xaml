<UserControl x:Class="EarthRelief3D.App.Views.DataCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12" MaxWidth="900" MaxHeight="640" Foreground="White">
    <!-- DataContext: DataViewModel. The Data card (Plan 5 Task 4): every source with what it gives, how the app uses it, its date,
         its licence and its credit. Centred over the globe, at most 900 x 640 at 100% (MainWindow.FitCards sets the maximum from
         the text size and the window), opaque, text only. Its owner (MainWindow) shows it from CardHost.DataOpen; Esc closes it
         first (SceneController). The table scrolls inside the card. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GlobeCore.Wpf;component/Styles/CardStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:NullToCollapsedConverter x:Key="NullToCollapsed" xmlns:local="clr-namespace:EarthRelief3D.App.Views"/>

            <Style x:Key="CellText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,0,10,0"/>
            </Style>
            <Style x:Key="HeadText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                <Setter Property="Foreground" Value="#C8CDD8"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style x:Key="PlainLicence" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding LicenceUrl}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="MessageText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#FFD27F"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,6,0,0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Message}" Value="">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border x:Name="Card" Background="#FF101624" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="8" Padding="16,12">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" LastChildFill="True">
                <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource CardButton}" Padding="8,1" Content="×" FontSize="16"
                        ToolTip="Close (Esc)" AutomationProperties.Name="Close the data sources" Command="{Binding CloseCommand}"
                        VerticalAlignment="Top"/>
                <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" FontSize="18" Foreground="White" TextWrapping="Wrap" Margin="0,0,8,0"/>
            </DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Intro}" Foreground="#C8CDD8" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Message}" Style="{StaticResource MessageText}"/>
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0" Focusable="False">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.7*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Source" Style="{StaticResource HeadText}"/>
                        <TextBlock Grid.Column="1" Text="What it gives" Style="{StaticResource HeadText}"/>
                        <TextBlock Grid.Column="2" Text="How" Style="{StaticResource HeadText}"/>
                        <TextBlock Grid.Column="3" Text="As of" Style="{StaticResource HeadText}"/>
                        <TextBlock Grid.Column="4" Text="Licence" Style="{StaticResource HeadText}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#33FFFFFF" BorderThickness="0,1,0,0" Padding="0,6,0,6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.7*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1.1*"/>
                                            <ColumnDefinition Width="1.6*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- The name opens the source's page; the licence opens its licence text (when it has a link). Both in the browser. -->
                                        <TextBlock Grid.Column="0" Style="{StaticResource CellText}">
                                            <Hyperlink Foreground="#7FB6FF" Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding Page}"><Run Text="{Binding Name, Mode=OneWay}"/> ↗</Hyperlink>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Text="{Binding What}" Style="{StaticResource CellText}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Use}" Style="{StaticResource CellText}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding AsOf}" Style="{StaticResource CellText}"/>
                                        <Grid Grid.Column="4">
                                            <TextBlock Style="{StaticResource CellText}" Visibility="{Binding LicenceUrl, Converter={StaticResource NullToCollapsed}}">
                                                <Hyperlink Foreground="#7FB6FF" Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding LicenceUrl}"><Run Text="{Binding Licence, Mode=OneWay}"/> ↗</Hyperlink>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Licence}" Style="{StaticResource PlainLicence}"/>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="5" Text="{Binding Credit}" Foreground="#9AA3B5" FontSize="11" TextWrapping="Wrap" Margin="0,3,10,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
