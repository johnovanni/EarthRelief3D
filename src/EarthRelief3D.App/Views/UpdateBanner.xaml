<UserControl x:Class="EarthRelief3D.App.Views.UpdateBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0" Focusable="False" Foreground="White"
             AutomationProperties.Name="New version of EarthRelief3D">
    <!-- DataContext: UpdateBannerViewModel. The update banner (Plan 5 Task 10, P5-19): top centre, a banner, not a pop-up and not a
         card; no sound, nothing modal. MainWindow.FitCards places it at the top, right of the layer strip, and moves the cards below
         it (R13), so it covers no card. It never takes the keyboard focus itself; its buttons are in
         the normal Tab order. Colour plus shape (C8): the ↑ mark and the outline, not the colour alone, say it is about a new version. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GlobeCore.Wpf;component/Styles/CardStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="B2V"/>
            <Style x:Key="BannerButton" TargetType="Button" BasedOn="{StaticResource CardButton}">
                <Setter Property="Padding" Value="10,3"/>
                <Setter Property="Margin" Value="0,6,8,0"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border x:Name="Card" Background="#FF14233D" BorderBrush="#FF7FB6FF" BorderThickness="1.5" CornerRadius="6" Padding="12,8"
            Visibility="{Binding IsVisible, Converter={StaticResource B2V}}" AutomationProperties.LiveSetting="Polite">
        <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="↑" FontSize="20" FontWeight="Bold" Foreground="#FF7FB6FF" Margin="0,-2,10,0"
                       VerticalAlignment="Top" AutomationProperties.Name="New version"/>
            <StackPanel>
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" Foreground="White"/>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" Foreground="#FFD27F" Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Message}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <WrapPanel Margin="0,2,0,0">
                    <Button Style="{StaticResource BannerButton}" Content="Download and install" Command="{Binding DownloadAndInstallCommand}"
                            Visibility="{Binding ShowDownload, Converter={StaticResource B2V}}"/>
                    <Button Style="{StaticResource BannerButton}" Content="Install now" Command="{Binding InstallNowCommand}"
                            Visibility="{Binding ShowInstallNow, Converter={StaticResource B2V}}"/>
                    <Button Style="{StaticResource BannerButton}" Content="Open the download page" Command="{Binding OpenDownloadPageCommand}"
                            Visibility="{Binding ShowOpenDownloadPage, Converter={StaticResource B2V}}" ToolTip="Opens the release's page on GitHub in your browser"/>
                    <Button Style="{StaticResource BannerButton}" Content="Check now" Command="{Binding CheckNowCommand}"
                            Visibility="{Binding ShowCheckNow, Converter={StaticResource B2V}}"/>
                    <Button Style="{StaticResource BannerButton}" Content="What's new" Command="{Binding WhatsNewCommand}"
                            Visibility="{Binding ShowWhatsNew, Converter={StaticResource B2V}}" ToolTip="Opens the release's page on GitHub in your browser"/>
                    <Button Style="{StaticResource BannerButton}" Content="Cancel" Command="{Binding CancelCommand}"
                            Visibility="{Binding ShowCancel, Converter={StaticResource B2V}}"/>
                    <Button Style="{StaticResource BannerButton}" Content="Later" Command="{Binding LaterCommand}"
                            Visibility="{Binding ShowLater, Converter={StaticResource B2V}}" ToolTip="Hides this until EarthRelief3D next starts"/>
                </WrapPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
