<UserControl x:Class="EarthRelief3D.App.Views.CountryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EarthRelief3D.App.Views"
             xmlns:vm="clr-namespace:EarthRelief3D.App.ViewModels"
             xmlns:pres="clr-namespace:EarthRelief3D.App.Presentation"
             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Width="380" Foreground="White">
    <!-- DataContext: CountryPanelViewModel. The "What is happening" part of the panel (spec §9.1). -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GlobeCore.Wpf;component/Styles/CardStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="B2V"/>
            <local:RowsConverter x:Key="Rows"/>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border x:Name="Card" Background="#F7101624" CornerRadius="8" Padding="14,10"
            Visibility="{Binding IsOpen, Converter={StaticResource B2V}}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" LastChildFill="True">
                <Button DockPanel.Dock="Right" Style="{StaticResource CardButton}" Padding="8,1" Content="×" FontSize="16"
                        ToolTip="Close (Esc)" Command="{Binding CloseCommand}" VerticalAlignment="Top"/>
                <TextBlock Text="{Binding CountryName}" FontWeight="SemiBold" FontSize="18" Margin="0,0,8,0"/>
            </DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="What is happening" Foreground="#C8CDD8" FontSize="12" FontWeight="SemiBold"
                       Margin="0,6,0,0"/>
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" MaxHeight="560" Margin="0,4,0,0">
                <StackPanel>
                    <!-- "No crisis recorded by these sources" only when every source has been checked; otherwise
                         "Not yet checked: ..." (ruling R12). -->
                    <TextBlock Text="{Binding Headline}" FontWeight="SemiBold" Margin="0,4,0,4"
                               Visibility="{Binding HasHeadline, Converter={StaticResource B2V}}"/>
                    <!-- No crisis (or only an IPC projection): the sources, each with the date it was checked. -->
                    <StackPanel Visibility="{Binding ShowsSourcesChecked, Converter={StaticResource B2V}}" Margin="0,0,0,8">
                        <TextBlock Text="Sources:" Foreground="#A0AEC0" FontSize="13" Margin="0,2,0,2"/>
                        <ItemsControl ItemsSource="{Binding SourcesChecked}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#D5DCE8" FontSize="13" TextWrapping="Wrap" Margin="8,1,0,1"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <ItemsControl x:Name="SectionList" ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4,0,10">
                                    <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" FontSize="15" Foreground="White" TextWrapping="Wrap"/>
                                    <ItemsControl ItemsSource="{Binding Rows, Converter={StaticResource Rows}}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" Foreground="#A0AEC0" FontSize="13" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="White" FontSize="13" TextWrapping="Wrap"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- Food (R17): the IPC phase bar, its caption and a row per phase. Null for other sections. -->
                                    <ContentControl Content="{Binding Bar}" Focusable="False" IsTabStop="False">
                                        <ContentControl.Resources>
                                            <!-- Implicit by type: a null Bar (other sections) makes nothing at all. -->
                                            <DataTemplate DataType="{x:Type pres:PhaseBar}">
                                                <StackPanel Margin="0,8,0,0">
                                                    <!-- Implicit TextBlock styles do not reach into a template: wrapping is set here. -->
                                                    <TextBlock Foreground="#A0AEC0" FontSize="13" TextWrapping="Wrap"
                                                               Text="{Binding OfAnalysed, StringFormat='People by IPC phase, {0}'}"/>
                                                    <local:PhaseBarView Bar="{Binding}" Margin="0,3,0,0"
                                                                        AutomationProperties.Name="{Binding AutomationName}"
                                                                        ToolTip="{Binding AutomationName}"
                                                                        Visibility="{Binding HasBar, Converter={StaticResource B2V}}"/>
                                                    <TextBlock Text="{Binding Caption}" Foreground="White" FontSize="13" Margin="0,3,0,2" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Note}" Foreground="#C8CDD8" FontSize="12" Margin="0,0,0,3" TextWrapping="Wrap"
                                                               Visibility="{Binding HasNote, Converter={StaticResource B2V}}"/>
                                                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,1">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="18"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="86"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2" Fill="{Binding Brush}"
                                                                               HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#D5DCE8" FontSize="13" TextWrapping="Wrap"/>
                                                                    <TextBlock Grid.Column="2" Text="{Binding People}" Foreground="White" FontSize="13"
                                                                               TextAlignment="Right" Margin="8,0,0,0"/>
                                                                    <TextBlock Grid.Column="3" Text="{Binding Percent}" Foreground="White" FontSize="13"
                                                                               TextAlignment="Right"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ContentControl.Resources>
                                    </ContentControl>
                                    <TextBlock Text="{Binding SourceLine}" Foreground="#9AA3B5" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Margin="0,2,0,0" FontSize="12"
                                               Visibility="{Binding Link, Converter={x:Static local:NullToCollapsedConverter.Instance}}">
                                        <Hyperlink Foreground="#7FB6FF" Click="OnSourceLinkClick" Tag="{Binding Link}">Source page ↗</Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Getting help in and your one small step: coming in a later version." Foreground="#8A92A3"
                               FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
