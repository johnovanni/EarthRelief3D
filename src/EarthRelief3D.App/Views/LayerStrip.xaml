<UserControl x:Class="EarthRelief3D.App.Views.LayerStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EarthRelief3D.App.ViewModels"
             xmlns:views="clr-namespace:EarthRelief3D.App.Views"
             HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12">
    <!-- DataContext: LayerStripViewModel. The Crises, Needs and Resources groups with their toggles (one shading at a time,
         markers stack: P3-6), then the group still to come (header only). -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GlobeCore.Wpf;component/Styles/CardStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="B2V"/>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="GroupHeader" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#C8CDD8"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="6,6,6,2"/>
            </Style>

            <!-- Layer toggle: the symbol is the Tag (drawn in the toggle's Foreground, the layer's colour), the label the Content. -->
            <Style x:Key="LayerButton" TargetType="ToggleButton">
                <Setter Property="Margin" Value="0,1"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
                <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
                <Setter Property="ToolTipService.Placement" Value="Right"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="4,0" Height="30">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Icon" Text="{TemplateBinding Tag}" Width="26" FontSize="17"
                                               TextAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                    <ContentPresenter x:Name="Label" Margin="6,0,6,0" VerticalAlignment="Center"
                                                      TextElement.Foreground="White" TextElement.FontSize="14"
                                                      Visibility="{Binding DataContext.IsExpanded, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}"/>
                                    <TextBlock x:Name="Off" Text="off" Foreground="#9AA3B5" FontSize="12" Margin="0,0,6,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#2E3A52"/>
                                </Trigger>
                                <!-- Off is shown in words too, not by dimming alone. -->
                                <Trigger Property="IsChecked" Value="False">
                                    <Setter TargetName="Icon" Property="Opacity" Value="0.4"/>
                                    <Setter TargetName="Label" Property="Opacity" Value="0.6"/>
                                    <Setter TargetName="Off" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#3A4866"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CommandButton" TargetType="ToggleButton" BasedOn="{StaticResource LayerButton}">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="4,0" Height="32">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{TemplateBinding Tag}" Width="26" FontSize="17" TextAlignment="Center"/>
                                    <ContentPresenter Margin="6,0,6,0" VerticalAlignment="Center" TextElement.Foreground="White"
                                                      TextElement.FontSize="14"
                                                      Visibility="{Binding DataContext.IsExpanded, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#3A4866"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- A collapsible group's header (R20): an arrow (open ▾, closed ▸, also said in words by "closed"), then the name
                 in the group-header look when the labels show. -->
            <Style x:Key="GroupButton" TargetType="ToggleButton">
                <Setter Property="Margin" Value="0,4,0,0"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
                <Setter Property="ToolTipService.Placement" Value="Right"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="4,0" Height="24">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Arrow" Text="▾" Width="26" FontSize="13" TextAlignment="Center" Foreground="#C8CDD8"/>
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding DataContext.IsExpanded, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}">
                                        <TextBlock Text="{Binding Name}" Foreground="#C8CDD8" FontSize="12" FontWeight="SemiBold" Margin="2,0,6,0"/>
                                        <TextBlock x:Name="Closed" Text="closed" Foreground="#9AA3B5" FontSize="11" Margin="0,0,6,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="False">
                                    <Setter TargetName="Arrow" Property="Text" Value="▸"/>
                                    <Setter TargetName="Closed" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#3A4866"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="#CC101624" CornerRadius="8" Padding="4">
        <!-- Scrolls when the window is too short for every group (MainWindow sets the strip's MaxHeight). -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel>
            <ToggleButton Style="{StaticResource CommandButton}" Tag="≡" Content="Layers"
                          IsChecked="{Binding IsExpanded}" ToolTip="Show or hide the labels"/>

            <!-- Crises, Needs and Resources: a header (with the one-shading note), then one toggle per layer. -->
            <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:LayerGroup}">
                        <StackPanel>
                            <!-- Crises (always open): its name, with the labels. -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsCollapsible}" Value="False"/>
                                                    <Condition Binding="{Binding DataContext.IsExpanded, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Style="{StaticResource GroupHeader}" Text="{Binding Name}"/>
                            </StackPanel>
                            <!-- Needs and Resources (R20): the header opens and closes the group; the arrow shows with or without labels. -->
                            <ToggleButton Style="{StaticResource GroupButton}" IsChecked="{Binding IsOpen}"
                                          ToolTip="{Binding HeaderTooltip}"
                                          Visibility="{Binding IsCollapsible, Converter={StaticResource B2V}}"/>
                            <TextBlock Text="{Binding Note}" Foreground="#9AA3B5" FontSize="11" Margin="6,0,6,2">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasNote}" Value="True"/>
                                                    <Condition Binding="{Binding IsOpen}" Value="True"/>
                                                    <Condition Binding="{Binding DataContext.IsExpanded, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Toggles}" Focusable="False"
                                          Visibility="{Binding IsOpen, Converter={StaticResource B2V}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:LayerToggle}">
                                        <ToggleButton Style="{StaticResource LayerButton}" Tag="{Binding Symbol}" Content="{Binding Label}"
                                                      Foreground="{Binding Brush}" IsChecked="{Binding IsChecked}" ToolTip="{Binding Tooltip}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Settings (P3-5): a gear at the end of the strip; the flyout opens under it. -->
            <StackPanel Visibility="{Binding HasSettings, Converter={StaticResource B2V}}" Margin="0,6,0,0">
                <ToggleButton Style="{StaticResource CommandButton}" Tag="⚙" Content="Settings"
                              IsChecked="{Binding Settings.IsOpen}" ToolTip="Settings: whose formal determinations are shown"/>
                <views:SettingsFlyout DataContext="{Binding Settings}"/>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
