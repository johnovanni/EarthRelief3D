<UserControl x:Class="EarthRelief3D.App.Views.SettingsFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EarthRelief3D.App.ViewModels"
             Foreground="White" MaxWidth="300">
    <!-- DataContext: SettingsViewModel. Opens under the gear at the end of the layer strip (P3-5, C15). It is part of the
         strip, not a pop-up, so the snapshot pictures can show it. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
    </UserControl.Resources>
    <Border Background="#E6182238" CornerRadius="6" Padding="10,8" Margin="2,4,2,2"
            Visibility="{Binding IsOpen, Converter={StaticResource B2V}}">
        <StackPanel>
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="×" FontSize="15" Padding="6,0" Command="{Binding CloseCommand}"
                        ToolTip="Close the settings" Background="Transparent" Foreground="White" BorderThickness="0"/>
                <TextBlock Text="Settings" FontWeight="SemiBold" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="{x:Static vm:SettingsViewModel.DeterminationsGroup}" Foreground="#C8CDD8" FontSize="12"
                       FontWeight="SemiBold" Margin="0,8,0,2"/>
            <TextBlock Text="{x:Static vm:SettingsViewModel.DeterminationsNote}" Foreground="#9AA3B5" FontSize="11"
                       TextWrapping="Wrap" Margin="0,0,0,4"/>
            <ItemsControl ItemsSource="{Binding Governments}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:GovernmentChoice}">
                        <StackPanel Margin="0,3">
                            <CheckBox IsChecked="{Binding IsChecked}" Foreground="White" FontSize="13">
                                <TextBlock Text="{Binding Name}" Foreground="White" TextWrapping="Wrap"/>
                            </CheckBox>
                            <TextBlock Text="{Binding Note}" Foreground="#9AA3B5" FontSize="11" TextWrapping="Wrap" Margin="20,1,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="No government's determinations are listed completely yet." Foreground="#9AA3B5" FontSize="11"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasGovernments}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
