<UserControl x:Class="EarthRelief3D.App.Views.Legend"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EarthRelief3D.App.ViewModels"
             HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" MaxWidth="560" Foreground="White">
    <!-- DataContext: LegendViewModel. One line per visible layer: symbol, what it measures, source and as-of date (the crisis
         lines, then the Plan 3 entries). -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GlobeCore.Wpf;component/Styles/CardStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="B2V"/>

            <!-- One legend line (a LegendLine or a LegendEntry): symbol, what it measures, its keys, a note, source and as-of. -->
            <DataTemplate x:Key="LineTemplate">
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Symbol}" Foreground="{Binding Brush}" FontSize="16" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Measures}" Foreground="White" FontSize="13" TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{Binding Keys}" Margin="0,2,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,1,10,1">
                                        <!-- A filled swatch (round for the power plants' fuels and sizes, sized for a size class, Task 7); for the food outline (R17) a ring in the outline's colour; for the faint tint (round 2) a ring around a faint fill;
                                             for "no figure: not shaded" (P3-7) an empty box with a thin grey edge. -->
                                        <Rectangle Width="{Binding Swatch}" Height="{Binding Swatch}" RadiusX="{Binding Radius}" RadiusY="{Binding Radius}" Margin="0,0,5,0" VerticalAlignment="Center">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Fill" Value="{Binding Brush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOutline}" Value="True">
                                                            <Setter Property="Fill" Value="{x:Null}"/>
                                                            <Setter Property="Stroke" Value="{Binding Brush}"/>
                                                            <Setter Property="StrokeThickness" Value="2.5"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsFaint}" Value="True">
                                                            <Setter Property="Fill" Value="{Binding FaintBrush}"/>
                                                            <Setter Property="Stroke" Value="{Binding Brush}"/>
                                                            <Setter Property="StrokeThickness" Value="1.5"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsNone}" Value="True">
                                                            <Setter Property="Fill" Value="{x:Null}"/>
                                                            <Setter Property="Stroke" Value="{Binding Brush}"/>
                                                            <Setter Property="StrokeThickness" Value="1"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>
                                        <TextBlock Text="{Binding Label}" Foreground="#D5DCE8" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Note}" Foreground="#C8CDD8" FontSize="12" TextWrapping="Wrap" Margin="0,1,0,1"
                                   Visibility="{Binding HasNote, Converter={StaticResource B2V}}"/>
                        <TextBlock Text="{Binding SourceLine}" Foreground="#9AA3B5" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Background="#F2101624" CornerRadius="8" Padding="10,8">
        <!-- A header row (P5-24: a button, so a click, Enter or Space opens and closes it), the body only when open, and the UN
             note always: under the header when folded, at the foot of the body when open (as "Borders: ... UN note"). -->
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ToggleButton x:Name="HeaderButton" Grid.Row="0" Style="{x:Null}" IsChecked="{Binding IsOpen}" HorizontalAlignment="Left"
                      Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="2,1"
                      ToolTip="{x:Static vm:LegendViewModel.HeaderTooltip}" AutomationProperties.Name="Legend">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <!-- A dock panel, not a row: in a narrow window (large text) the header's words wrap. -->
                        <DockPanel LastChildFill="True">
                            <TextBlock x:Name="Arrow" DockPanel.Dock="Left" Text="▾" Width="20" FontSize="13" TextAlignment="Center" Foreground="#C8CDD8" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Closed" DockPanel.Dock="Right" Text="closed" Foreground="#9AA3B5" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                            <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold" FontSize="13" Foreground="#C8CDD8" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="Arrow" Property="Text" Value="▸"/>
                            <Setter TargetName="Closed" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#3A4866"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#7FB6FF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>
        <!-- Folded: just the UN note, small and grey, under the header. -->
        <TextBlock Grid.Row="2" Text="{Binding UnNote}" Foreground="#8A92A3" FontSize="11" TextWrapping="Wrap" Margin="22,2,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <!-- Scrolls instead of growing over the layer strip when the window is short (MainWindow sets the card's MaxHeight). -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0" Visibility="{Binding IsOpen, Converter={StaticResource B2V}}">
        <StackPanel>
            <ItemsControl ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource LineTemplate}"/>
            <!-- Plan 3: the shading that is on (unless food) and the marker layers the crisis lines do not cover. -->
            <ItemsControl ItemsSource="{Binding Entries}" ItemTemplate="{StaticResource LineTemplate}"/>
            <!-- P5-12: the January rule for FTS appeals; empty (and collapsed) the rest of the year. -->
            <TextBlock Text="{Binding FtsNote}" Foreground="#8A92A3" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FtsNote}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- The flyout: reports the source published that could not be put on the map. -->
            <ToggleButton x:Name="UnplacedButton" Style="{x:Null}" Margin="0,6,0,0" HorizontalAlignment="Left" Background="Transparent"
                          BorderThickness="0" Foreground="#7FB6FF" Cursor="Hand" Focusable="False"
                          Visibility="{Binding HasUnplaced, Converter={StaticResource B2V}}">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <TextBlock FontSize="12" Foreground="#7FB6FF">
                            <Run Text="{Binding UnplacedHeader, Mode=OneWay}"/>
                            <Run Text="▸"/>
                        </TextBlock>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>
            <Popup StaysOpen="False" AllowsTransparency="True" PopupAnimation="None" Placement="Top"
                   PlacementTarget="{Binding ElementName=UnplacedButton}"
                   IsOpen="{Binding IsChecked, ElementName=UnplacedButton, Mode=TwoWay}">
                <Border Background="#F0101624" BorderBrush="#3A4256" BorderThickness="1" CornerRadius="6" Padding="10,8" MaxWidth="420">
                    <StackPanel>
                        <TextBlock Text="{x:Static vm:LegendViewModel.UnplacedTitle}" FontWeight="SemiBold" Foreground="White" FontSize="13"/>
                        <TextBlock Text="Published by the source, but no country on the map could be found for them." Foreground="#C8CDD8"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,2,0,6"/>
                        <ItemsControl ItemsSource="{Binding Unplaced}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="12" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Detail}" Foreground="#9AA3B5" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Popup>

            <TextBlock Text="{Binding BoundaryText}" Foreground="#8A92A3" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
        </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
